# ── Server ──────────────────────────────────────────────
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking

# ── Redis (optional, webhook queue) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-different-long-random-secret
REFRESH_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Gmail webhook ───────────────────────────────────────
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── Seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@booking.local
SEED_ADMIN_PASSWORD=admin123
