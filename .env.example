# ── Server ──────────────────────────────────────────────
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking

# ── Redis (optional, webhook queue) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-different-long-random-secret
REFRESH_EXPIRES_IN=7d

# ── Cookie (cross-origin dev: ngrok/HTTPS) ───────────────
# COOKIE_SECURE=true + COOKIE_SAME_SITE=none  -> required for cross-origin cookies on HTTPS
# COOKIE_SECURE=false + COOKIE_SAME_SITE=lax  -> default for local HTTP
# COOKIE_SECURE=false + COOKIE_SAME_SITE=none -> INVALID (will throw error)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Google OAuth ────────────────────────────────────────
# MỘT Google OAuth Client dùng chung cho CẢ HAI luồng được.
# Trong Google Cloud Console phải khai báo ĐỦ CẢ HAI redirect URI:
#   1) Đăng nhập app :  https://<host>/api/auth/google/callback
#   2) Theo dõi mailbox: https://<host>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Luồng ĐĂNG NHẬP (GET /api/auth/google):
#   Redirect URI TỰ ĐỘNG được dựng từ BASE_URL thành
#   {BASE_URL}/api/auth/google/callback.
#   -> GOOGLE_REDIRECT_URI KHÔNG dùng cho luồng này.
BASE_URL=http://localhost:4000

# Luồng THEO DÕI MAILBOX (GET /api/gmail/connect):
#   Phải khớp CHÍNH XÁC redirect URI đã khai báo cho mailbox ở trên.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# Tuỳ chọn: điền sẵn mailbox duy nhất được phép trên màn hình consent.
GOOGLE_ALLOWED_EMAIL=

# ── Gmail webhook ───────────────────────────────────────
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── Mail ingestion allow-list ───────────────────────────
# Chỉ ingest mail từ các sender ở đây (domain hoặc email, ngăn cách bằng dấu phẩy).
# Mail từ sender khác sẽ bị IGNORE. VD: tripadvisor.com,getyourguide.com,viator.com
MAIL_ALLOWED_SENDERS=tripadvisor.com,getyourguide.com,viator.com

# ── Seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@booking.local
SEED_ADMIN_PASSWORD=admin123
