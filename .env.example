# ── Server ──────────────────────────────────────────────
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking

# ── Redis (optional, webhook queue) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-different-long-random-secret
REFRESH_EXPIRES_IN=7d

# ── Cookie (cross-origin dev: ngrok/HTTPS) ───────────────
# COOKIE_SECURE=true + COOKIE_SAME_SITE=none  -> required for cross-origin cookies on HTTPS
# COOKIE_SECURE=false + COOKIE_SAME_SITE=lax  -> default for local HTTP
# COOKIE_SECURE=false + COOKIE_SAME_SITE=none -> INVALID (will throw error)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Google OAuth ────────────────────────────────────────
# MỘT Google OAuth Client dùng chung cho CẢ HAI luồng được.
# Trong Google Cloud Console phải khai báo ĐỦ CẢ HAI redirect URI:
#   1) Đăng nhập app :  https://<host>/api/auth/google/callback
#   2) Theo dõi mailbox: https://<host>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Luồng ĐĂNG NHẬP (GET /api/auth/google):
#   Redirect URI TỰ ĐỘNG được dựng từ BASE_URL thành
#   {BASE_URL}/api/auth/google/callback.
#   -> GOOGLE_REDIRECT_URI KHÔNG dùng cho luồng này.
BASE_URL=http://localhost:4000

# Luồng THEO DÕI MAILBOX (GET /api/gmail/connect):
#   Phải khớp CHÍNH XÁC redirect URI đã khai báo cho mailbox ở trên.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# Tuỳ chọn: điền sẵn mailbox duy nhất được phép trên màn hình consent.
GOOGLE_ALLOWED_EMAIL=

# ── Gmail webhook ───────────────────────────────────────
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
# Transport used by this project: TRUE = in-process streaming pull on
# GOOGLE_PUBSUB_SUBSCRIPTION (no push webhook). Pull requires
# GOOGLE_APPLICATION_CREDENTIALS + pubsub.subscriptions.consume.
# Self-healing: a missing/deleted subscription is retried every
# GOOGLE_PUBSUB_RECONNECT_MS and connects automatically once it exists.
GOOGLE_PUBSUB_PULL_ENABLED=true
# Create the subscription on startup when missing (needs roles/pubsub.editor).
GOOGLE_PUBSUB_AUTO_CREATE_SUBSCRIPTION=true
GOOGLE_PUBSUB_RECONNECT_MS=30000
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── Gmail polling (no Pub/Sub required) ─────────────────
# true = poll the Gmail history API directly on an interval (pure pull; needs no
# topic/subscription). Runs the SAME pipeline as the other transports.
GMAIL_POLL_ENABLED=false
GMAIL_POLL_INTERVAL_MS=60000

# ── Booking sync confirmation ───────────────────────────
# Forward the source mail with 'this mail with booking ref "X" was pushed to the
# Booking table successfully' after CREATED/UPDATED/CANCELLED. Needs the
# gmail.send scope (reconnect the mailbox once). Empty BOOKING_FORWARD_TO = off.
BOOKING_FORWARD_ENABLED=false
BOOKING_FORWARD_TO=

# ── Mail ingestion allow-list ───────────────────────────
# Chỉ ingest mail từ các sender ở đây (domain hoặc email, ngăn cách bằng dấu phẩy).
# Mail từ sender khác sẽ bị IGNORE. VD: tripadvisor.com,getyourguide.com,viator.com
# 1 sender = 1 brand — test senders hiện tại (thay bằng domain brand thật khi production):
#   nquocnhu95book@gmail.com      -> tripadvisor
#   nquocnhu95tourguide@gmail.com -> website
MAIL_ALLOWED_SENDERS=tripadvisor.com,getyourguide.com,viator.com
# Template routing: [field:]prefix=templateTag (comma separated), env wins over the defaults.
# from:expmessaging.tripadvisor.com -> every mail of the Viator/Tripadvisor message centre
# (NOT-<uuid>@…) goes to the advancedViator template (new booking / cancel / amend).
# from:bokun.io -> the Bókun booking notification goes to the standard viator template
# (a sub-domain sender such as @hanatourist.bokun.io matches the domain rule too).
MAIL_TEMPLATE_PREFIX_RULES=from:expmessaging.tripadvisor.com=advancedViator,from:advancedViator@expmessaging.tripadvisor.com=advancedViator,from:bokun.io=viator,subject:conversation with=advancedViator

# ── Seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@booking.local
SEED_ADMIN_PASSWORD=admin123

# ── File Storage (avatar & Drive files) ─────────────────
# local (default) | s3 | supabase. Empty = auto-detect from the env below.
STORAGE_DRIVER=local

# Local physical server. Empty UPLOAD_ROOT = backend/uploads.
# Production example: UPLOAD_ROOT=/var/www/booking/uploads
UPLOAD_ROOT=
# Empty = {BASE_URL}/uploads
PUBLIC_UPLOADS_BASE=

# ── S3 / S3-compatible ──────────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# ── Supabase Storage (S3-compatible) ────────────────────
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=booking
SUPABASE_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_PUBLIC_URL=
SUPABASE_FORCE_PATH_STYLE=true
