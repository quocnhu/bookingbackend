generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────
enum AuthProvider {
  LOCAL
  GOOGLE
}

enum RoleType {
  ADMIN
  OFFICE
  TOUR_GUIDE
  DRIVER
  TRANSPORT_PROVIDER
  CUSTOMER
}

enum TourType {
  PRIVATE_TOUR
  GROUP_TOUR
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum BookingStatus {
  PENDING // Newly created / waiting for vehicle assignment
  ASSIGNED // Assigned to a trip (Assignment)
  CANCELED // Booking cancelled
}

enum AssignmentStatus {
  DRAFT_ASSIGNED // Admin drag-drop booking onto a bus but NOT dispatched yet
  PENDING // Driver + Guide + Vehicle all set — waiting to depart
  TRANSFERRED // Drag-drop changed vehicle/position — needs realtime update
  DISPATCHED // Bus departed
  VERIFYING // Guide / driver submitted — waiting for Admin or Accounting to verify
  COMPLETED // Tour finished
  CANCELED // Operations cancelled
}

enum AssignmentOrigin {
  MANUAL // Created by Admin by hand (default)
  AUTO_ASSIGN // Created by the Auto-Assign engine / queue
}

enum GuideType {
  OFFICIAL // In-house guide (paid on a period basis)
  FREELANCE // Freelance guide (settled per tour)
}

enum DriverType {
  COMPANY // In-house company driver
  FREELANCE // Freelance driver, settled per tour
}

enum TourReportStatus {
  SUBMITTED // Guide sent the report after the tour — waiting for Admin verification
  VERIFIED // Admin / manager verified it as valid → Tour COMPLETED
  REJECTED // Rejected — guide needs to resubmit
}

enum FeeFlowType {
  COLLECT_MONEY // Collected on behalf — the trip creator owes the company
  PAY_MONEY // Company pays — the company owes the trip creator
}

enum BookingProvider {
  TRIPADVISOR // Automatic from TripAdvisor webhook / mail
  GETYOURGUIDE // Automatic from Gmail Pub/Sub for GetYourGuide bookings
  AIRBNB // Automatic from Gmail Pub/Sub for Airbnb bookings
  BOOKING_COM // Automatic from Gmail Pub/Sub for Booking.com bookings
  WEBSITE // Automatic from Gmail Pub/Sub for Website bookings
  MANUAL // Admin/Office created by hand on the dashboard
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── RBAC — ROLES & PERMISSIONS (PROCESS_FLOW section 2.3) ─────────────
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) // ADMIN = system, cannot be deleted
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  code      String           @unique // e.g. "booking.update", "user.delete"
  name      String
  group     String? // Group used to group the checkbox in the UI
  roleLinks RolePermission[]
  userLinks UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// ─── AUTH, USERS, LEAVES & SESSIONS ──────────────────────────────────
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  role         RoleType     @default(OFFICE)
  isActive     Boolean      @default(true)
  lastLogin    DateTime?

  // Security: lock the account after too many failed sign-in attempts
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?

  // RBAC (section 2.3): separate roles + permissions, plus extra classification
  roles       UserRole[]
  permissions UserPermission[]
  userType    String?

  // Drive: storage quota in MB. ADMIN = unlimited.
  storageQuotaMb Int @default(3072)

  providerId String?
  provider   TransportationProvider? @relation(fields: [providerId], references: [id])

  driverProfile DriverProfile?
  guideProfile  GuideProfile?

  // Assignment relations
  driverAssignments Assignment[] @relation("DriverAssignment")
  guidedAssignments Assignment[] @relation("GuideAssignment")
  reportVerifies    Assignment[] @relation("ReportVerifier")

  // Leave management & sessions
  leaves         UserLeave[]
  reviewedLeaves UserLeave[]    @relation("LeaveReviewedBy")
  sessions       UserSession[]
  auditLogs      AuditLog[]
  authActivities AuthActivity[]

  // Drive (personal storage, Google Drive style)
  driveFolders DriveFolder[] @relation("UserDriveFolders")
  driveFiles   DriveFile[]   @relation("UserDriveFiles")

  // Notifications & push
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  // Accounting Room
  settlementEntries Settlement[]        @relation("SettlementCreatedBy")
  paymentPeriods    PaymentPeriod[]     @relation("PeriodCreatedBy")
  moneyVerifies     TourReport[]        @relation("MoneyVerifiedBy")
  moneyPayableTos   TourReport[]        @relation("MoneyPayableTo")
  settledTours      PaymentPeriodLine[] @relation("LinePayableTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserLeave {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate, endDate])
}

model UserSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String? @unique
  ipAddress String?
  userAgent String?

  loggedInAt  DateTime  @default(now())
  loggedOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([loggedInAt])
}

model DriverProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String
  type          DriverType @default(COMPANY) // In-house driver or freelance
  rating        Float      @default(5.0)
}

model GuideProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      GuideType @default(FREELANCE)
  languages String[]
  rating    Float     @default(5.0)
}

// ─── COMPANY PROFILE (digital signature / annual settlement printing) ──────────
// Singleton table — the service always reads the first row, updated via PUT.
model CompanyProfile {
  id            String   @id @default(uuid())
  name          String
  address       String?
  phone         String?
  email         String?
  taxId         String?
  website       String?
  rootLatitude  Float? // Depot coordinate — used to calculate pickup distance
  rootLongitude Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── SYSTEM SETTINGS (global switches, e.g. dispatch board assign mode) ─
// Singleton rows keyed by `key` — upserted on read so the row always exists.
model SystemSetting {
  key       String   @id // e.g. "assignMode"
  value     String // e.g. "AUTO_ASSIGN" | "MANUAL"
  updatedAt DateTime @updatedAt
}

// ─── TOUR & LOGISTICS ────────────────────────────────────────────────
model Tour {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. TOUR-0001
  name         String   @unique
  type         TourType
  thumbnailUrl String? // e.g. cover image shown on cards

  adultPrice   Decimal? @default(0)
  childPrice   Decimal? @default(0)
  infantPrice  Decimal? @default(0)
  currency     String   @default("USD")
  durationDays Int?     @default(1) // Half-day tours = 1; otherwise number of days

  // Promotion / discount — separate per tour type
  privateDiscountPercent Int?      @default(0) // % off Private Tour during the promotion window
  groupDiscountPercent   Int?      @default(0) // % off Group Tour during the promotion window
  promotionStartsAt      DateTime?
  promotionEndsAt        DateTime?

  // Tour detail page content (layout similar to a "Tour Itinerary" page)
  departureLocation String? // Departure point
  transportation    String? // Transportation type
  overview          String? @db.Text // Overview (HTML bullet list)
  includedServices  String? @db.Text // Included services (HTML list)
  excludedServices  String? @db.Text // Excluded services (HTML list)
  childrenPolicy    String? @db.Text // Child pricing (HTML list)
  regulations       String? @db.Text // Terms & conditions (HTML)
  highlights        String? @db.Text // Highlights (HTML)
  insurancePolicy   String? @db.Text // Insurance policy (HTML)
  mapQuery          String? // Google Maps embed map centre query

  itineraries TourItinerary[]
  gallery     TourGallery[]
  departures  TourDeparture[]
  typePrices  TourTypePrice[]
  prices      RoutePrice[]
  bookings    Booking[]
}

model TourTypePrice {
  id          String   @id @default(uuid())
  tourId      String
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type        TourType // PRIVATE_TOUR / GROUP_TOUR
  adultPrice  Decimal  @default(0)
  childPrice  Decimal  @default(0)
  infantPrice Decimal  @default(0)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tourId, type])
  @@index([tourId])
}

model TourDeparture {
  id     String @id @default(uuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  departureDate DateTime
  adultPrice    Decimal  @default(0)
  childPrice    Decimal  @default(0)
  infantPrice   Decimal  @default(0)

  createdAt DateTime @default(now())

  @@index([tourId, departureDate])
}

model TourItinerary {
  id     String @id @default(uuid())
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  dayNumber   Int     @default(1) // Day 1, Day 2, etc.
  orderIndex  Int     @default(0) // Sequence within the day
  title       String // e.g., "Visit Marble Mountain"
  description String? @db.Text
  timeSlot    String? // e.g., "08:30 AM - 10:00 AM"
  location    String? // Destination name
  imageUrl    String? // Item thumbnail (picked from backend uploads)
  mapQuery    String? // Location / query for the Google Maps embed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId, dayNumber, orderIndex])
}

// Tour slideshow image folder — generated automatically when a tour is created.
model TourGallery {
  id         String   @id @default(uuid())
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  url        String
  storageKey String   @unique
  sortIndex  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([tourId, sortIndex])
}

model TransportationProvider {
  id          String       @id @default(uuid())
  name        String
  // Company-owned fleet (Company Fleet): the company's own vehicles/guides are
  // internal resources, always priced at 0 VND and preferred by auto-assign
  // ahead of third-party providers.
  isCompany   Boolean      @default(false)
  users       User[]
  vehicles    Vehicle[]
  routePrices RoutePrice[]
  assignments Assignment[]
}

model Vehicle {
  id          String                 @id @default(uuid())
  plateNumber String
  capacity    Int?                   @default(12)
  brand       String?
  providerId  String
  provider    TransportationProvider @relation(fields: [providerId], references: [id])
  assignments Assignment[]
  routePrices RoutePrice[]
}

model RoutePrice {
  id         String                 @id @default(uuid())
  tourId     String
  tour       Tour                   @relation(fields: [tourId], references: [id])
  providerId String
  provider   TransportationProvider @relation(fields: [providerId], references: [id])
  vehicleId  String
  vehicle    Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  price      Decimal

  @@unique([tourId, providerId, vehicleId])
}

// ─── BOOKING & ASSIGNMENT ────────────────────────────────────────────
model Booking {
  id         String @id @default(uuid())
  bookingRef String @unique

  channel BookingProvider @default(MANUAL)
  status  BookingStatus   @default(PENDING)
  tourId  String?
  tour    Tour?           @relation(fields: [tourId], references: [id])

  // Origin / confirmation code (upsert key per .md: source + confirmationCode)
  source           String?
  confirmationCode String?

  address      String?
  latitude     Float?
  longitude    Float?
  startingDate DateTime?

  customerName String?
  hotelName    String
  phone        String
  mail         String?
  totalPax     Int            @default(0)
  paxDetail    String?
  tourType     TourType?
  tourName     String?
  payment      PaymentStatus? @default(PAID)

  isNoShow     Boolean @default(false)
  noShowReason String?

  // Internal note for this booking (dietary needs, pickup point, collect/refund instructions...)
  notes     String?  @db.Text
  rawDataId String?  @unique
  rawData   RawData? @relation(fields: [rawDataId], references: [id])

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  paxSequence  Int         @default(0) // Used for drag-and-drop passenger ordering on the bus

  settlements Settlement[]

  // Provenance record when a passenger is dragged onto another bus (keeps the red colour / "MOVED from" tag)
  movedFromBusId String?
  movedFromBus   Assignment? @relation("MovedFromBus", fields: [movedFromBusId], references: [id], onDelete: SetNull)

  createdWho String? // Who created the booking: user name or "Pub-Sub System"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, confirmationCode])
  @@index([assignmentId, paxSequence])
}

model Assignment {
  id            String    @id @default(uuid())
  code          String? // Display name for the bus/vehicle (e.g. "Bus 01", "29-seat coach")
  bookings      Booking[]
  // Passengers that were dragged from this bus onto another one (Booking.movedFromBus)
  movedBookings Booking[] @relation("MovedFromBus")

  // Trip start and end times (supports both 1-day and multi-day tours)
  startDate DateTime
  endDate   DateTime

  // ── Key trip details (auto-aggregated from bookings during auto-assign) ──
  tourName     String? // Main tour name for this trip
  tourType     TourType? // PRIVATE_TOUR / GROUP_TOUR
  durationDays Int? // Tour length in days (from Tour.durationDays)
  totalPax     Int       @default(0) // Total pax for the trip (auto-aggregated from bookings)
  pickupInfo   Json? // [{ bookingRef, customerName, pickup, totalPax, latitude, longitude }]
  latitude     Float? // Centroid of all pickup points, used for the map
  longitude    Float?

  vehicleId  String?
  vehicle    Vehicle?                @relation(fields: [vehicleId], references: [id])
  providerId String?
  provider   TransportationProvider? @relation(fields: [providerId], references: [id])

  driverId String?
  driver   User?   @relation("DriverAssignment", fields: [driverId], references: [id])
  guideId  String?
  guide    User?   @relation("GuideAssignment", fields: [guideId], references: [id])

  // Person responsible for verifying this trip's guide report (admin / office)
  reportVerifierId String?
  reportVerifier   User?   @relation("ReportVerifier", fields: [reportVerifierId], references: [id])

  settlements  Settlement[]
  paymentLines PaymentPeriodLine[]

  status        AssignmentStatus @default(PENDING)
  origin        AssignmentOrigin @default(MANUAL)
  sequenceIndex Int              @default(0)
  priceOverride Decimal?
  tripNotes     String?          @db.Text
  createdWho    String? // Who created the assignment: user name or "Auto-Assign System"

  tourReport TourReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sequenceIndex])
  @@index([startDate, endDate]) // Optimises availability queries filtered by date range
}

// ─── TOUR REPORT (guide reports after the tour finishes) ──────────────────
model TourReport {
  id           String     @id @default(uuid())
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  // Submitter (the trip's main guide, or OFFICE acting on their behalf)
  submittedById   String?
  submittedByName String?
  submittedAt     DateTime @default(now())

  // Tour report content
  actualPax   Int?
  pickupNotes String?  @db.Text
  distanceKm  Float?
  fuelCost    Decimal?
  tollParking Decimal?
  notes       String?  @db.Text

  status TourReportStatus @default(SUBMITTED)

  // Verified by Admin / manager
  verifiedById      String?
  verifiedByName    String?
  verifiedAt        DateTime?
  verificationNotes String?   @db.Text

  // Who finalized the trip (Confirm finished): real name of the acting user.
  finalizedById   String?
  finalizedByName String?
  finalizedAt     DateTime?

  // ─── Accounting Room: money lock ──────────────────────────────────────
  // settlementFlow + netAmount are LOCKED when Accounting verifies, then immutable.
  // Cash direction is derived from the Settlement rows, never set by hand.
  settlementFlow        FeeFlowType?
  netAmount             Decimal?
  moneyVerifiedById     String?
  moneyVerifiedBy       User?        @relation("MoneyVerifiedBy", fields: [moneyVerifiedById], references: [id])
  moneyVerifiedByName   String?
  moneyVerifiedAt       DateTime?
  moneyVerificationNote String?      @db.Text

  // The person RECEIVING money for this trip (guide or driver), fixed at verify time.
  // Required: one trip has only one net amount. Without storing it, both the guide
  // and the driver would see that amount and could both export a period → paid twice.
  moneyPayableToId     String?
  moneyPayableTo       User?        @relation("MoneyPayableTo", fields: [moneyPayableToId], references: [id])

  // Accounting reviews then clicks Verify or Reject. Reject → notify the submitter
  // to check again; the trip leaves the queue until it is resubmitted.
  moneyRejectedAt       DateTime?
  moneyRejectedById     String?
  moneyRejectedByName   String?
  moneyRejectionReason  String?      @db.Text

  // Receipt / evidence photos the guide took after the tour. [{ name, url, uploadedAt }].
  // From upload until Admin verification, everything stays in "pending verification" state.
  evidenceImages Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([finalizedAt])
  @@index([moneyVerifiedAt])
  @@index([moneyPayableToId])
}

// ─── ACCOUNTING ROOM: settlements & payment periods ───────────────────
// Model: a money entry belongs to a trip (Assignment) and/or a booking.
// Accounting verifies a trip → locks netAmount (immutable) → exports a payment
// period per person (guide or driver). Each period keeps the original detail
// lines (PaymentPeriodLine) so an exported statement never changes its numbers later.

model SettlementCategory {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  flowType    FeeFlowType
  isSystem    Boolean      @default(false)
  settlements Settlement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Settlement {
  id     String  @id @default(uuid())
  amount Decimal // Always positive. Direction is decided by category.flowType.
  note   String?

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  categoryId String?
  category   SettlementCategory? @relation(fields: [categoryId], references: [id])

  createdById   String
  createdBy     User     @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Immutable once the trip's money is locked. If a mistake is made, create a
  // reversal row — never edit or delete the original.
  reversesId String?     @unique
  reverses   Settlement? @relation("SettlementReversal", fields: [reversesId], references: [id])
  reversedBy Settlement? @relation("SettlementReversal")

  @@index([assignmentId])
  @@index([bookingId])
  @@index([categoryId])
}

enum PayeeType {
  TRANSPORT_PROVIDER // Third-party transport provider (template groups many drivers under one provider)
  COMPANY_GUIDE // In-house guide
  COMPANY_DRIVER // In-house driver
  FREELANCE // Freelance driver + freelance guide
}

model PaymentPeriod {
  id        String    @id @default(uuid())
  personId  String // userId (guide/driver) or providerId (third-party transport provider)
  payeeType PayeeType @default(COMPANY_GUIDE) // Payee group, decides how periods are grouped
  payeeName String? // Name snapshot taken at export time
  fromDate  DateTime
  toDate    DateTime

  tourCount              Int     @default(0)
  personReturnsToCompany Decimal @default(0) // Trip creator owes the company
  companyReturnsToPerson Decimal @default(0) // Company owes the trip creator
  totalNet               Decimal // = personReturnsToCompany - companyReturnsToPerson
  note                   String? @db.Text

  createdById   String
  createdBy     User     @relation("PeriodCreatedBy", fields: [createdById], references: [id])
  createdByName String?
  createdAt     DateTime @default(now())

  // Period was VOIDED because it was wrong. Never hard-deleted — money data must
  // remain for reconciliation. All logic (watermark, dedupe, history) skips voided periods.
  voidedAt     DateTime?
  voidedById   String?
  voidedByName String?
  voidReason   String?      @db.Text

  lines PaymentPeriodLine[]

  @@index([personId, toDate])
  @@index([createdAt])
}

// A FROZEN detail line of a period. Never recalculated from live data: if a
// tour/booking is edited later, an already exported statement keeps its old numbers.
model PaymentPeriodLine {
  id       String        @id @default(uuid())
  periodId String
  period   PaymentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  payableToId  String
  payableTo    User       @relation("LinePayableTo", fields: [payableToId], references: [id])

  tourName  String?
  tourDate  DateTime
  netAmount Decimal
  flow      FeeFlowType
  note      String?

  @@unique([periodId, assignmentId])
  @@index([payableToId])
}

// ─── UTILS & PUB/SUB MAILBOX ──────────────────────────────────────────

model GmailAccount {
  id              String   @id @default(uuid())
  email           String   @unique
  lastHistoryId   String
  watchExpiration DateTime
  refreshToken    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RawData {
  id          String   @id @default(uuid())
  sourceId    String   @unique
  payload     Json
  status      String
  payloadHash String?
  email       String?
  templateTag String? // 'airbnb' | 'booking-com' | 'tripadvisor' | 'website' | 'unknown' — tag from the ingest step (header match)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking?

  @@index([payloadHash])
}

model Coordinate {
  id         String   @id @default(uuid())
  hotelName  String
  starRating String?
  address    String   @unique
  coordinate String?
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([latitude, longitude])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  beforeData Json?
  afterData  Json?
  changedBy  String?
  user       User?    @relation(fields: [changedBy], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── AUTH ACTIVITY ──────────────────────────────────────────────────
// Records authentication events (sign-in / sign-out / failure), kept separate from the audit log.
model AuthActivity {
  id           String        @id @default(uuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType    String
  authProvider AuthProvider?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── DRIVE (personal storage, Google Drive style) ──────────────────────
// userId nullable + SetNull: when a user is deleted, their drive and avatar
// folders are kept (not deleted).
model DriveFolder {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation("UserDriveFolders", fields: [userId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    DriveFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DriveFolder[] @relation("FolderTree")
  files     DriveFile[]
  name      String
  kind      String        @default("folder") // "root" | "avatar" | "folder"
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, parentId])
}

model DriveFile {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation("UserDriveFiles", fields: [userId], references: [id], onDelete: SetNull)
  folderId   String
  folder     DriveFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String?
  size       Int
  storageKey String      @unique // Relative path under backend/uploads/drive
  createdAt  DateTime    @default(now())

  @@index([userId, folderId])
}

// ─── NOTIFICATIONS & PUSH SUBSCRIPTIONS ──────────────────────────────

enum NotificationType {
  ASSIGNED // Assigned to a trip
  TRANSFERRED // Trip changed bus / position
  CANCELED // Passenger cancelled / trip cancelled
  REPORT_VERIFIED // Tour report confirmed
  REPORT_REJECTED // Tour report rejected
  MONEY_REJECTED // Accounting returned the money sheet for re-checking
  MONEY_VERIFIED // Accounting locked the trip's money
  LEAVE_REQUESTED // Staff requested leave — needs Admin approval
  LEAVE_APPROVED // Admin approved the leave request
  LEAVE_REJECTED // Admin rejected the leave request
  GENERAL // General notification
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  body      String           @db.Text
  data      Json? // Extra payload (assignmentId, bookingId, ...)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String // FCM registration token
  userAgent String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}
